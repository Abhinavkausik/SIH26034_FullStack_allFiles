# ==============================================================================
# LMPC Compliance Inspector Backend Configuration (server/.env)
# Copy this file to .env before starting the backend server.
# ==============================================================================

# Server HTTP Port
PORT=5000

# Secret used to sign authority JWT tokens - change this in production
JWT_SECRET=change_this_to_a_long_random_string

# Token lifetime for authority login sessions (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Accounts created by `npm run seed`.
# Leave the passwords BLANK to have the seed script generate a strong random
# password and print it once. Never commit a real password here.
DEFAULT_ADMIN_USERNAME=lm_admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Controller of Legal Metrology

DEFAULT_AUTHORITY_USERNAME=authority_admin
DEFAULT_AUTHORITY_PASSWORD=
DEFAULT_AUTHORITY_NAME=Senior Legal Metrology Inspector

# Scan pipeline mode:
#   live     - always use the Python OCR + VLM pipeline (default)
#   fallback - use Python, fall back to the built-in rule engine if it fails
#   demo     - skip Python entirely and use the built-in rule engine
SCAN_MODE=live

# Google Gemini API key used by the VLM compliance pipeline
GEMINI_API_KEY=your_gemini_api_key_here

# Python executable path for running the OCR and compliance bridge
# Windows example: C:\path\to\venv\Scripts\python.exe
# Linux/macOS example: /path/to/venv/bin/python
PYTHON_EXECUTABLE=python

# Python project root path containing the 'src' module for OCR compliance
# Example: C:\path\to\SIH_PADDLE
PYTHONPATH=.

# Disable MKLDNN/oneDNN default in Paddle to prevent CPU crashes on certain platforms
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
