# Copy this file to .env before running the server

PORT=5000

# Secret used to sign authority JWT tokens - change this in production
JWT_SECRET=change_this_to_a_long_random_string

# Token lifetime for authority login sessions
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Default demo authority account created by `npm run seed`
DEFAULT_AUTHORITY_USERNAME=authority_admin
DEFAULT_AUTHORITY_PASSWORD=ChangeMe123
DEFAULT_AUTHORITY_NAME=Senior Legal Metrology Inspector
